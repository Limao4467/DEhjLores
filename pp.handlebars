1  <!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WAPT! inscrição de doação de livros</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1 id="bem-vindo">BENVINDO! FAÇA SEU LOGIN PARA CONTINUAR COM O SEU PROGRESSO!</h1>

  <h4>Preencha os campos abaixo para se cadastrar.</h4>

  <label for="nome">Informe seu nome por favor:</label>
  <input type="text" id="nome" name="nome" placeholder="Digite seu nome aqui">
  <button type="button" onclick="salvarNome()">Salvar</button>

  <h3>Escolha uma senha segura</h3>
  <label for="senha">Insira sua senha (mínimo 6 dígitos):</label>
  <input type="password" id="senha" name="senha" placeholder="Insira sua senha aqui">
  <button type="button" onclick="salvarSenha()">Salvar</button>

  <label for="continuar">Clique no botão abaixo para continuar:</label>
  <a href="qq.html">Clique aqui para continuar</a>

